# MemoriaViva RISE - Variables de Entorno
# Duplica este archivo como .env y coloca tus claves reales

# Clave API de Google Gemini (Obtén una gratis en https://aistudio.google.com/)
GEMINI_API_KEY=tu_api_key_de_gemini_aqui

# Bot de Telegram (Obtén el token en @BotFather en Telegram)
TELEGRAM_BOT_TOKEN=tu_token_de_bot_aqui

# ID de chat de Telegram del cuidador (ej. obtenido de @userinfobot)
TELEGRAM_CHAT_ID=tu_chat_id_aqui
